<!--数据绑定-->
<view class="container" style="position: relative; left: 0rpx; top: 344rpx">
<!--姓名绑定-->
<view class="view-contain-ti">
<text class="text-ti">姓名</text>
<input type="text" bindinput="name" class="input1"></input>
</view>

<!--手机号绑定-->
<view class="view-contain-ti">
<text class="text-ti">手机号</text>
<input type="number" bindinput="phone" class="input1"></input>
</view>

<!--班级绑定-->
<view class="view-contain-ti">
<text class="text-ti">班级</text>
<input bindinput="banji" class="input1"></input>
</view>

<button class="button1" style="width: 196rpx; height: 80rpx; display: block; box-sizing: border-box; left: 0rpx; top: -12rpx; position: relative" bindtap="save" hidden="{{Hidden}}">保存</button>
</view>

