<view class="section" style="position: relative; left: 169rpx; top: -1112rpx; width: 444rpx; height: 82rpx; display: block; box-sizing: border-box">
  <picker bindchange="bindPickerChange" value="{{index}}" range="{{array}}" style="position: relative; left: 0rpx; top: 0rpx; width: 400rpx; height: 86rpx; display: block; box-sizing: border-box">
    <button class="picker;button2" style="position: relative; left: 0rpx; top: 0rpx; width: 220rpx; height: 86rpx; display: block; box-sizing: border-box">
    {{array[index]}}</button>
  </picker>
</view>

